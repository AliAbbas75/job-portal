# Serve API calls from in-browser mock data (true) or the Flask backend (false).
# Every page has a backend endpoint now; use false with `flask run`. Override locally in
# .env.local (gitignored).
VITE_USE_MOCKS=true

# Cloudflare Turnstile site key for the signup/login CAPTCHA. Leave empty in development: a
# checkbox stands in. The backend's CAPTCHA_SECRET_KEY must be set to the matching secret.
VITE_TURNSTILE_SITE_KEY=
