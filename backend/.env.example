# Copy to backend/.env. Values here match docker-compose.yml at the repo root.
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL from `docker compose up -d db` (host port 5433 avoids clashing with a local install).
DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5433/job_portal
TEST_DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5433/job_portal_test

# Change both for any shared or production environment. Use 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me-dev-jwt-secret

# Where uploaded candidate documents are stored (gitignored).
UPLOAD_FOLDER=uploads

# OTP SMS: "console" prints codes to the flask log (development default). No real gateway yet.
SMS_BACKEND=console
# Cloudflare Turnstile secret for the signup CAPTCHA. Leave empty in development to skip it.
CAPTCHA_SECRET_KEY=

# Number of different approvers who must approve a job before it can be published.
JOB_APPROVALS_REQUIRED=1
